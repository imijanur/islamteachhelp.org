{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "islamteachhelp",
  "compatibility_date": "2026-10-01",
  // Static site generated by `go run ./cmd/export`
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
